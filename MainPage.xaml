<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:r="clr-namespace:SLMobileViewer.Rendering"
             x:Class="SLMobileViewer.MainPage"
             Shell.NavBarIsVisible="False"
             Title="SL Mobile Viewer">

    <Grid>

        <!-- LOGIN -->
        <ScrollView x:Name="LoginPanel">
            <VerticalStackLayout Padding="26" Spacing="12" VerticalOptions="Center">
                <Label Text="SL Mobile" FontSize="34" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="Second Life / OpenSim viewer" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                <BoxView HeightRequest="10" Color="Transparent" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Entry x:Name="FirstNameEntry" Placeholder="Username / First name" />
                        <Entry x:Name="LastNameEntry" Placeholder="Last name (blank = Resident)" />
                        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True"
                               IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" />
                        <HorizontalStackLayout Spacing="2">
                            <CheckBox x:Name="ShowPwCheck" CheckedChanged="OnShowPwChanged" />
                            <Label Text="Show password" VerticalOptions="Center" Style="{StaticResource Muted}" />
                        </HorizontalStackLayout>
                        <Entry x:Name="StartLocationEntry" Placeholder="last, home or region name" Text="last" />
                    </VerticalStackLayout>
                </Border>

                <Button x:Name="ConnectButton" Text="Connect" HeightRequest="50" Clicked="OnConnectClicked" />
                <ActivityIndicator x:Name="LoginSpinner" IsRunning="False" />
                <Label x:Name="LoginStatusLabel" TextColor="#E0A040" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Button x:Name="ThemeButtonLogin" Text="Switch theme" Style="{StaticResource Ghost}"
                        HorizontalOptions="Center" Clicked="OnToggleTheme" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- MAIN -->
        <Grid x:Name="ViewportPanel" IsVisible="False" RowDefinitions="Auto,*,Auto" Padding="8,6" RowSpacing="6">

            <!-- header -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <VerticalStackLayout>
                    <Label x:Name="SelfNameLabel" Text="" Style="{StaticResource Title}" />
                    <Label x:Name="StatusLabel" Text="Connected" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" x:Name="ThemeButton" Text="Theme" Style="{StaticResource Ghost}"
                        Clicked="OnToggleTheme" />
                <Button Grid.Column="2" Text="Log out" Style="{StaticResource Danger}" Clicked="OnLogoutClicked" />
            </Grid>

            <!-- WORLD -->
            <Grid Grid.Row="1" x:Name="WorldPanel" RowDefinitions="*,Auto" RowSpacing="6">
                <Grid>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <r:WorldView x:Name="World3D" />
                    </Border>

                    <!-- selected object card -->
                    <Border x:Name="SelectionCard" Style="{StaticResource Card}" IsVisible="False"
                            VerticalOptions="End" Margin="6">
                        <VerticalStackLayout Spacing="6">
                            <Label x:Name="SelName" Style="{StaticResource Title}" LineBreakMode="TailTruncation" />
                            <Label x:Name="SelDesc" Style="{StaticResource Muted}" MaxLines="3"
                                   LineBreakMode="TailTruncation" />
                            <Label x:Name="SelMeta" Style="{StaticResource Muted}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Touch" Clicked="OnTouchObject" />
                                <Button Text="Sit" Style="{StaticResource Ghost}" Clicked="OnSitObject" />
                                <Button Text="Stand" Style="{StaticResource Ghost}" Clicked="OnStandUp" />
                                <Button Text="Close" Style="{StaticResource Ghost}" Clicked="OnCloseSelection" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="5">

                    <!-- bake status / actions -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <Label x:Name="BakeLabel" Style="{StaticResource Muted}" VerticalOptions="Center"
                               LineBreakMode="TailTruncation" Text="Scene not built yet" />
                        <Button Grid.Column="1" x:Name="BuildButton" Text="Build 20 m"
                                FontSize="12" Padding="10,6" Clicked="OnBuildScene" />
                        <Button Grid.Column="2" x:Name="ExtendButton" Text="Extend"
                                Style="{StaticResource Ghost}" FontSize="12" Padding="10,6"
                                IsVisible="False" Clicked="OnExtendScene" />
                    </Grid>
                    <ProgressBar x:Name="BakeBar" Progress="0" IsVisible="False" />

                    <!-- movement pad -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="4">
                        <Button x:Name="BtnTurnL" Text="&#x21B0;" FontSize="17" Padding="0,10"
                                Pressed="OnTurnLeftDown" Released="OnMoveUp" />
                        <Button Grid.Column="1" x:Name="BtnFwd" Text="&#x25B2;" FontSize="15" Padding="0,10"
                                Pressed="OnForwardDown" Released="OnMoveUp" />
                        <Button Grid.Column="2" x:Name="BtnTurnR" Text="&#x21B1;" FontSize="17" Padding="0,10"
                                Pressed="OnTurnRightDown" Released="OnMoveUp" />
                        <Button Grid.Column="3" x:Name="BtnBack" Text="&#x25BC;" FontSize="15" Padding="0,10"
                                Pressed="OnBackDown" Released="OnMoveUp" />
                        <Button Grid.Column="4" x:Name="BtnJump" Text="Jump" FontSize="11" Padding="0,10"
                                Pressed="OnJumpDown" Released="OnMoveUp" />
                        <Button Grid.Column="5" x:Name="BtnFly" Text="Fly" FontSize="11" Padding="0,10"
                                Style="{StaticResource Ghost}" Clicked="OnToggleFly" />
                    </Grid>

                    <!-- range + audio -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                        <Label Text="Range" VerticalOptions="Center" Style="{StaticResource Muted}" />
                        <Picker Grid.Column="1" x:Name="RangePicker" WidthRequest="92" FontSize="12"
                                SelectedIndexChanged="OnRangeChanged" />
                        <Label Grid.Column="2" x:Name="AudioLabel" Style="{StaticResource Muted}"
                               VerticalOptions="Center" LineBreakMode="TailTruncation" />
                        <Button Grid.Column="3" x:Name="AudioButton" Text="Audio" Style="{StaticResource Ghost}"
                                FontSize="12" Padding="10,6" Clicked="OnAudioToggle" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>

            <!-- CHAT -->
            <Grid Grid.Row="1" x:Name="ChatPanel" IsVisible="False" RowDefinitions="*,Auto" RowSpacing="6">
                <Border Style="{StaticResource Card}">
                    <CollectionView x:Name="ChatList" ItemsUpdatingScrollMode="KeepLastItemInView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" FontSize="13" Padding="2,3" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Entry x:Name="ChatEntry" Placeholder="Say something..." Completed="OnSendClicked" />
                    <Button Grid.Column="1" Text="Send" Clicked="OnSendClicked" />
                </Grid>
            </Grid>

            <!-- PEOPLE -->
            <Grid Grid.Row="1" x:Name="PeoplePanel" IsVisible="False" RowDefinitions="Auto,*,Auto,*" RowSpacing="2">
                <Label Text="NEARBY PEOPLE — tap for profile" Style="{StaticResource SectionHeader}" />
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                    <CollectionView x:Name="PeopleList" SelectionMode="Single" SelectionChanged="OnPersonSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="6,9">
                                    <Label Text="{Binding Name}" />
                                    <Label Grid.Column="1" Text="{Binding DistanceText}" Style="{StaticResource Muted}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                <Label Grid.Row="2" Text="NEARBY OBJECTS" Style="{StaticResource SectionHeader}" />
                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
                    <CollectionView x:Name="NearbyList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="6,5">
                                    <Label Text="{Binding Name}" FontSize="13" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding DistanceText}" Style="{StaticResource Muted}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- FRIENDS -->
            <Grid Grid.Row="1" x:Name="FriendsPanel" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="2">
                <Label x:Name="FriendsHeader" Text="FRIENDS" Style="{StaticResource SectionHeader}" />
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                    <CollectionView x:Name="FriendsList" SelectionMode="Single" SelectionChanged="OnFriendSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="6,10" ColumnSpacing="10">
                                    <Ellipse WidthRequest="10" HeightRequest="10" VerticalOptions="Center"
                                             Fill="{Binding StatusColor}" />
                                    <Label Grid.Column="1" Text="{Binding Name}" />
                                    <Label Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>

            <!-- IM -->
            <Grid Grid.Row="1" x:Name="ImPanel" IsVisible="False">
                <Grid x:Name="ImListView" RowDefinitions="Auto,*" RowSpacing="2">
                    <Label Text="CONVERSATIONS" Style="{StaticResource SectionHeader}" />
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                        <CollectionView x:Name="ImThreadList" SelectionMode="Single" SelectionChanged="OnThreadSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="6,11">
                                        <Label Text="{Binding Name}" />
                                        <Label Grid.Column="1" Text="{Binding Badge}" TextColor="#E060C0" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </Grid>

                <Grid x:Name="ImThreadView" IsVisible="False" RowDefinitions="Auto,*,Auto" RowSpacing="6">
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Text="Back" Style="{StaticResource Ghost}" Clicked="OnImBack" />
                        <Label Grid.Column="1" x:Name="ImTitle" Style="{StaticResource Title}"
                               VerticalOptions="Center" Margin="10,0,0,0" LineBreakMode="TailTruncation" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <CollectionView x:Name="ImMessages" ItemsUpdatingScrollMode="KeepLastItemInView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" FontSize="13" Padding="2,3" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Entry x:Name="ImEntry" Placeholder="Message..." Completed="OnImSend" />
                        <Button Grid.Column="1" Text="Send" Clicked="OnImSend" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- GROUPS -->
            <Grid Grid.Row="1" x:Name="GroupsPanel" IsVisible="False">
                <Grid x:Name="GroupListView" RowDefinitions="Auto,*" RowSpacing="2">
                    <Label Text="GROUP CHATS" Style="{StaticResource SectionHeader}" />
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                        <CollectionView x:Name="GroupThreadList" SelectionMode="Single"
                                        SelectionChanged="OnGroupSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="6,11">
                                        <Label Text="{Binding Name}" />
                                        <Label Grid.Column="1" Text="{Binding Badge}" TextColor="#E060C0" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </Grid>

                <Grid x:Name="GroupThreadView" IsVisible="False" RowDefinitions="Auto,*,Auto" RowSpacing="6">
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Text="Back" Style="{StaticResource Ghost}" Clicked="OnGroupBack" />
                        <Label Grid.Column="1" x:Name="GroupTitle" Style="{StaticResource Title}"
                               VerticalOptions="Center" Margin="10,0,0,0" LineBreakMode="TailTruncation" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <CollectionView x:Name="GroupMessages" ItemsUpdatingScrollMode="KeepLastItemInView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" FontSize="13" Padding="2,3" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Entry x:Name="GroupEntry" Placeholder="Message group..." Completed="OnGroupSend" />
                        <Button Grid.Column="1" Text="Send" Clicked="OnGroupSend" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- PROFILE -->
            <ScrollView Grid.Row="1" x:Name="ProfilePanel" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Button Text="Back" Style="{StaticResource Ghost}" HorizontalOptions="Start"
                            Clicked="OnProfileBack" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="ProfName" FontSize="20" FontAttributes="Bold" />
                            <Label x:Name="ProfBorn" Style="{StaticResource Muted}" />
                            <Label x:Name="ProfPartner" Style="{StaticResource Muted}" />
                            <BoxView HeightRequest="1" Color="#33808080" />
                            <Label Text="ABOUT" Style="{StaticResource SectionHeader}" />
                            <Label x:Name="ProfAbout" />
                            <Label Text="FIRST LIFE" Style="{StaticResource SectionHeader}" />
                            <Label x:Name="ProfRl" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Send IM" Clicked="OnProfileIm" />
                                <Button Text="Add friend" Style="{StaticResource Ghost}" Clicked="OnProfileFriend" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- TABS -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="3">
                <Button x:Name="TabWorld" Text="World" FontSize="11" Padding="0,8" Clicked="OnTabWorld" />
                <Button Grid.Column="1" x:Name="TabChat" Text="Chat" FontSize="11" Padding="0,8" Clicked="OnTabChat" />
                <Button Grid.Column="2" x:Name="TabPeople" Text="People" FontSize="11" Padding="0,8" Clicked="OnTabPeople" />
                <Button Grid.Column="3" x:Name="TabFriends" Text="Friends" FontSize="11" Padding="0,8" Clicked="OnTabFriends" />
                <Button Grid.Column="4" x:Name="TabIm" Text="IM" FontSize="11" Padding="0,8" Clicked="OnTabIm" />
                <Button Grid.Column="5" x:Name="TabGroups" Text="Groups" FontSize="11" Padding="0,8" Clicked="OnTabGroups" />
            </Grid>
        </Grid>

        <!-- LSL BLUE MENU -->
        <Grid x:Name="DialogOverlay" IsVisible="False" BackgroundColor="#99000000">
            <Border VerticalOptions="End" Style="{StaticResource Card}" Margin="8">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="DialogTitleLabel" Style="{StaticResource Title}" />
                    <Label x:Name="DialogMessageLabel" FontSize="13" />
                    <FlexLayout x:Name="DialogButtonsLayout" Wrap="Wrap" JustifyContent="Start" />
                    <Button Text="Ignore" Style="{StaticResource Ghost}" Clicked="OnDialogIgnoreClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
